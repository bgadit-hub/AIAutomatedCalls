{
  "name": "AI Agency — Post-Call Processing (Vapi)",
  "nodes": [

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "post-call",
        "responseMode": "immediatelyOnStart",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook — Vapi Post-Call",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 400],
      "notes": "Path: post-call. Set N8N_WEBHOOK_URL to your lead-trigger URL — vapi-webhook.js derives this URL by replacing /lead-trigger with /post-call automatically.\n\nReceived fields:\n  vapi_call_id, lead_id, client_id, layer, call_status,\n  outcome, transcript, recording_url, duration_sec, cost_cents"
    },

    {
      "parameters": {
        "jsCode": "const secret = $input.first().json.headers?.['x-webhook-secret'];\nconst expected = $env.N8N_WEBHOOK_SECRET;\nif (expected && secret !== expected) {\n  throw new Error('Webhook secret mismatch — rejected');\n}\nconst body = $input.first().json.body;\nif (!body?.transcript || body.transcript.trim().length < 20) {\n  throw new Error('No transcript — skipping analysis');\n}\nreturn [{ json: body }];"
      },
      "id": "node-verify",
      "name": "Verify & Extract Body",
      "type": "n8n-nodes-base.code",
      "position": [460, 400],
      "notes": "Verifies webhook secret and checks transcript exists.\nRequires N8N_WEBHOOK_SECRET env var (same value as in Cloudflare)."
    },

    {
      "parameters": {
        "dataPropertyName": "layer",
        "rules": {
          "rules": [
            { "value": "layer1", "outputKey": "sales" },
            { "value": "layer2", "outputKey": "client" }
          ]
        },
        "fallbackOutput": "client"
      },
      "id": "node-route-layer",
      "name": "Route by Layer",
      "type": "n8n-nodes-base.switch",
      "position": [680, 400],
      "notes": "layer1 = our AI sales calls to prospects\nlayer2 = client's AI receptionist calls to their patients"
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "json",
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 600,
          "messages": [
            {
              "role": "user",
              "content": "Analyze this AI sales call transcript. The AI was calling a local business owner about getting an AI receptionist / voice agent service.\n\nCall status: {{ $json.call_status }}\nDuration: {{ $json.duration_sec }} seconds\n\nReturn ONLY a valid JSON object with these exact fields (no markdown, no preamble):\n{\n  \"outcome\": \"payment_agreed\" | \"demo_booked\" | \"follow_up_booked\" | \"send_info\" | \"not_interested\" | \"voicemail\" | \"no_answer\" | \"other\",\n  \"sentiment\": \"positive\" | \"neutral\" | \"negative\",\n  \"score\": integer 1-10 (likelihood to close),\n  \"summary\": \"2-3 sentence summary of what happened\",\n  \"objections\": [\"array of specific objections raised\"],\n  \"next_step\": \"one specific action needed\",\n  \"key_insight\": \"one insight about this prospect\",\n  \"improvement_tips\": [\"up to 3 specific things the AI could have done better\"]\n}\n\nTranscript:\n{{ $json.transcript }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-claude-sales",
      "name": "Claude — Analyze Sales Call (L1)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [900, 220],
      "notes": "Credential: HTTP Header Auth\n  Name: Anthropic-API\n  Header: x-api-key\n  Value: your Anthropic API key\nAlso add header: anthropic-version = 2023-06-01"
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "json",
        "body": {
          "model": "claude-sonnet-4-20250514",
          "max_tokens": 700,
          "messages": [
            {
              "role": "user",
              "content": "Analyze this AI receptionist call transcript. The AI was handling inbound/outbound calls for a local business (dental, medical, HVAC, law firm, etc.) on behalf of a client.\n\nCall status: {{ $json.call_status }}\nDuration: {{ $json.duration_sec }} seconds\n\nReturn ONLY a valid JSON object (no markdown, no preamble):\n{\n  \"summary\": \"2-3 sentence summary of the call\",\n  \"outcome\": \"appointment_booked\" | \"information_provided\" | \"callback_requested\" | \"transferred\" | \"complaint_handled\" | \"voicemail\" | \"no_answer\" | \"other\",\n  \"caller_sentiment\": \"positive\" | \"neutral\" | \"negative\",\n  \"appointment_booked\": true | false,\n  \"appointment_details\": {\"date\": \"...\", \"time\": \"...\", \"type\": \"...\"} or null,\n  \"key_moments\": [\"array of 2-4 important moments in the call\"],\n  \"missed_opportunities\": [\"things the AI could have handled better — be specific\"],\n  \"ai_coaching_notes\": \"one paragraph of coaching notes to improve the AI agent's performance\",\n  \"caller_intent\": \"brief description of why the caller called\"\n}\n\nTranscript:\n{{ $json.transcript }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-claude-client",
      "name": "Claude — Analyze Client Call (L2)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [900, 580],
      "notes": "Same Anthropic credential as L1 node."
    },

    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content?.[0]?.text || '{}';\nconst clean = raw.replace(/```json|```/g, '').trim();\ntry {\n  const analysis = JSON.parse(clean);\n  const incoming = $('Route by Layer').item.json;\n  return [{ json: {\n    ...incoming,\n    analysis,\n    layer: 'layer1',\n  }}];\n} catch(e) {\n  const incoming = $('Route by Layer').item.json;\n  return [{ json: {\n    ...incoming,\n    analysis: { outcome: 'other', summary: 'Parse error: ' + e.message, score: 0, sentiment: 'neutral', objections: [], next_step: 'Manual review needed', key_insight: '', improvement_tips: [] },\n    layer: 'layer1',\n    parse_error: e.message,\n  }}];\n}"
      },
      "id": "node-parse-sales",
      "name": "Parse Sales Response (L1)",
      "type": "n8n-nodes-base.code",
      "position": [1140, 220]
    },

    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content?.[0]?.text || '{}';\nconst clean = raw.replace(/```json|```/g, '').trim();\ntry {\n  const analysis = JSON.parse(clean);\n  const incoming = $('Route by Layer').item.json;\n  return [{ json: {\n    ...incoming,\n    analysis,\n    layer: 'layer2',\n  }}];\n} catch(e) {\n  const incoming = $('Route by Layer').item.json;\n  return [{ json: {\n    ...incoming,\n    analysis: { outcome: 'other', summary: 'Parse error: ' + e.message, caller_sentiment: 'neutral', appointment_booked: false, key_moments: [], missed_opportunities: [], ai_coaching_notes: '' },\n    layer: 'layer2',\n    parse_error: e.message,\n  }}];\n}"
      },
      "id": "node-parse-client",
      "name": "Parse Client Response (L2)",
      "type": "n8n-nodes-base.code",
      "position": [1140, 580]
    },

    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/recordings?vapi_call_id=eq.{{ $json.vapi_call_id }}&select=id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "node-get-recording-l1",
      "name": "Get Recording ID (L1)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1360, 220],
      "notes": "Fetches internal recording.id from vapi_call_id.\nRequires n8n env vars: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY"
    },

    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/recordings?vapi_call_id=eq.{{ $('Parse Client Response (L2)').item.json.vapi_call_id }}&select=id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "node-get-recording-l2",
      "name": "Get Recording ID (L2)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1360, 580]
    },

    {
      "parameters": {
        "jsCode": "const recording = $input.first().json[0];\nif (!recording?.id) throw new Error('Recording not found for vapi_call_id: ' + $('Parse Sales Response (L1)').item.json.vapi_call_id);\nconst data = $('Parse Sales Response (L1)').item.json;\nreturn [{ json: {\n  recording_id: recording.id,\n  data,\n}}];"
      },
      "id": "node-prep-l1",
      "name": "Prep L1 Upsert Data",
      "type": "n8n-nodes-base.code",
      "position": [1580, 220]
    },

    {
      "parameters": {
        "jsCode": "const recording = $input.first().json[0];\nif (!recording?.id) throw new Error('Recording not found for vapi_call_id: ' + $('Parse Client Response (L2)').item.json.vapi_call_id);\nconst data = $('Parse Client Response (L2)').item.json;\nreturn [{ json: {\n  recording_id: recording.id,\n  data,\n}}];"
      },
      "id": "node-prep-l2",
      "name": "Prep L2 Upsert Data",
      "type": "n8n-nodes-base.code",
      "position": [1580, 580]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/call_transcripts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }
          ]
        },
        "contentType": "json",
        "body": {
          "recording_id": "={{ $json.recording_id }}",
          "transcript": "={{ $json.data.transcript }}",
          "summary": "={{ $json.data.analysis.summary }}",
          "key_moments": "={{ JSON.stringify($json.data.analysis.improvement_tips || []) }}",
          "missed_opps": "={{ JSON.stringify($json.data.analysis.objections || []) }}",
          "ai_notes": "={{ $json.data.analysis.key_insight + '\\n\\nNext step: ' + $json.data.analysis.next_step + '\\n\\nImprovement tips: ' + ($json.data.analysis.improvement_tips || []).join('; ') }}"
        },
        "options": {}
      },
      "id": "node-upsert-transcript-l1",
      "name": "Supabase — Save L1 Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1800, 220],
      "notes": "Upserts call_transcripts with Claude's sales call analysis.\nUnique constraint on recording_id ensures idempotency."
    },

    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/call_transcripts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }
          ]
        },
        "contentType": "json",
        "body": {
          "recording_id": "={{ $json.recording_id }}",
          "transcript": "={{ $json.data.transcript }}",
          "summary": "={{ $json.data.analysis.summary }}",
          "key_moments": "={{ JSON.stringify($json.data.analysis.key_moments || []) }}",
          "missed_opps": "={{ JSON.stringify($json.data.analysis.missed_opportunities || []) }}",
          "ai_notes": "={{ $json.data.analysis.ai_coaching_notes }}"
        },
        "options": {}
      },
      "id": "node-upsert-transcript-l2",
      "name": "Supabase — Save L2 Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1800, 580],
      "notes": "Upserts call_transcripts with Claude's client call analysis.\nFills summary, key_moments, missed_opps, ai_notes columns."
    },

    {
      "parameters": {
        "dataPropertyName": "data.analysis.outcome",
        "rules": {
          "rules": [
            { "value": "payment_agreed", "outputKey": "won" },
            { "value": "demo_booked", "outputKey": "demo" },
            { "value": "follow_up_booked", "outputKey": "followup" },
            { "value": "send_info", "outputKey": "sendinfo" },
            { "value": "not_interested", "outputKey": "dead" },
            { "value": "voicemail", "outputKey": "noanswer" },
            { "value": "no_answer", "outputKey": "noanswer" }
          ]
        },
        "fallbackOutput": "other"
      },
      "id": "node-route-outcome",
      "name": "Route by Sales Outcome",
      "type": "n8n-nodes-base.switch",
      "position": [2020, 220]
    },

    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $json.data.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "contentType": "json",
        "body": {
          "stage": "won",
          "call_status": "demo_booked",
          "qualified_score": "={{ $json.data.analysis.score }}",
          "notes": "={{ $json.data.analysis.summary }}"
        },
        "options": {}
      },
      "id": "node-sb-won",
      "name": "Supabase — Mark Lead Won",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2260, 60]
    },

    {
      "parameters": {
        "method": "PUT",
        "url": "=https://rest.gohighlevel.com/v1/contacts/{{ $json.data.ghl_contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "json",
        "body": {
          "tags": ["client-won", "awaiting-onboard"],
          "customField": {
            "call_outcome": "payment_agreed",
            "call_score": "={{ $json.data.analysis.score }}",
            "call_summary": "={{ $json.data.analysis.summary }}"
          }
        },
        "options": {}
      },
      "id": "node-ghl-won",
      "name": "GHL — Tag as Won",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2260, 140],
      "notes": "GHL credential: HTTP Header Auth, name: Authorization, value: Bearer [GHL_API_KEY]"
    },

    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $json.data.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "contentType": "json",
        "body": {
          "stage": "demo_booked",
          "call_status": "demo_booked",
          "demo_booked_at": "={{ new Date().toISOString() }}",
          "notes": "={{ $json.data.analysis.summary }}"
        },
        "options": {}
      },
      "id": "node-sb-demo",
      "name": "Supabase — Mark Demo Booked",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2260, 260]
    },

    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $json.data.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "contentType": "json",
        "body": {
          "stage": "follow_up",
          "call_status": "called",
          "notes": "={{ $json.data.analysis.summary + ' | Next: ' + $json.data.analysis.next_step }}"
        },
        "options": {}
      },
      "id": "node-sb-followup",
      "name": "Supabase — Mark Follow-Up",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2260, 360]
    },

    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $json.data.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "contentType": "json",
        "body": {
          "stage": "disqualified",
          "call_status": "called",
          "notes": "Not interested. {{ $json.data.analysis.summary }}"
        },
        "options": {}
      },
      "id": "node-sb-dead",
      "name": "Supabase — Mark Not Interested",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2260, 460]
    },

    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $json.data.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "contentType": "json",
        "body": {
          "call_status": "no_answer",
          "notes": "No answer / voicemail. Retry cron will pick this up."
        },
        "options": {}
      },
      "id": "node-sb-noanswer",
      "name": "Supabase — Mark No Answer",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2260, 560]
    },

    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ $json.data.analysis.appointment_booked }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equal" }
            }
          ]
        }
      },
      "id": "node-if-booked",
      "name": "Appointment Booked?",
      "type": "n8n-nodes-base.if",
      "position": [2020, 580],
      "notes": "If a patient appointment was booked during the call, trigger notification."
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/[YOUR_SLACK_WEBHOOK]",
        "contentType": "json",
        "body": {
          "text": "📅 *Patient appointment booked!*\nClient: {{ $json.data.client_id }}\nDetails: {{ JSON.stringify($json.data.analysis.appointment_details) }}\nSummary: {{ $json.data.analysis.summary }}"
        },
        "options": {}
      },
      "id": "node-slack-booked",
      "name": "Slack — Appointment Notification",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2260, 520],
      "notes": "Replace [YOUR_SLACK_WEBHOOK] with your actual Slack webhook URL.\nOr swap this for an email notification via GHL/Resend."
    }

  ],

  "connections": {
    "Webhook — Vapi Post-Call": {
      "main": [[{ "node": "Verify & Extract Body", "type": "main", "index": 0 }]]
    },
    "Verify & Extract Body": {
      "main": [[{ "node": "Route by Layer", "type": "main", "index": 0 }]]
    },
    "Route by Layer": {
      "sales": [[{ "node": "Claude — Analyze Sales Call (L1)", "type": "main", "index": 0 }]],
      "client": [[{ "node": "Claude — Analyze Client Call (L2)", "type": "main", "index": 0 }]]
    },
    "Claude — Analyze Sales Call (L1)": {
      "main": [[{ "node": "Parse Sales Response (L1)", "type": "main", "index": 0 }]]
    },
    "Claude — Analyze Client Call (L2)": {
      "main": [[{ "node": "Parse Client Response (L2)", "type": "main", "index": 0 }]]
    },
    "Parse Sales Response (L1)": {
      "main": [[{ "node": "Get Recording ID (L1)", "type": "main", "index": 0 }]]
    },
    "Parse Client Response (L2)": {
      "main": [[{ "node": "Get Recording ID (L2)", "type": "main", "index": 0 }]]
    },
    "Get Recording ID (L1)": {
      "main": [[{ "node": "Prep L1 Upsert Data", "type": "main", "index": 0 }]]
    },
    "Get Recording ID (L2)": {
      "main": [[{ "node": "Prep L2 Upsert Data", "type": "main", "index": 0 }]]
    },
    "Prep L1 Upsert Data": {
      "main": [[{ "node": "Supabase — Save L1 Analysis", "type": "main", "index": 0 }]]
    },
    "Prep L2 Upsert Data": {
      "main": [[{ "node": "Supabase — Save L2 Analysis", "type": "main", "index": 0 }]]
    },
    "Supabase — Save L1 Analysis": {
      "main": [[{ "node": "Route by Sales Outcome", "type": "main", "index": 0 }]]
    },
    "Supabase — Save L2 Analysis": {
      "main": [[{ "node": "Appointment Booked?", "type": "main", "index": 0 }]]
    },
    "Route by Sales Outcome": {
      "won":      [[{ "node": "Supabase — Mark Lead Won", "type": "main", "index": 0 }, { "node": "GHL — Tag as Won", "type": "main", "index": 0 }]],
      "demo":     [[{ "node": "Supabase — Mark Demo Booked", "type": "main", "index": 0 }]],
      "followup": [[{ "node": "Supabase — Mark Follow-Up", "type": "main", "index": 0 }]],
      "sendinfo": [[{ "node": "Supabase — Mark Follow-Up", "type": "main", "index": 0 }]],
      "dead":     [[{ "node": "Supabase — Mark Not Interested", "type": "main", "index": 0 }]],
      "noanswer": [[{ "node": "Supabase — Mark No Answer", "type": "main", "index": 0 }]],
      "other":    [[{ "node": "Supabase — Mark Follow-Up", "type": "main", "index": 0 }]]
    },
    "Appointment Booked?": {
      "true":  [[{ "node": "Slack — Appointment Notification", "type": "main", "index": 0 }]],
      "false": []
    }
  },

  "settings": { "executionOrder": "v1" },

  "_SETUP_NOTES": {
    "description": "Post-call processing for both Layer 1 (AI sales calls) and Layer 2 (client AI receptionist calls).",
